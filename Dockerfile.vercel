# Motor de contenedor Vercel: requiere disponibilidad de su runtime de contenedores.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 VERCEL=1 OCR_LANG=spa+eng APP_MODE=demo
WORKDIR /srv/adea
RUN apt-get update && apt-get install -y --no-install-recommends \
      tesseract-ocr tesseract-ocr-spa libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-vision.txt requirements.txt ./
RUN pip install --no-cache-dir -r requirements-vision.txt
COPY app ./app
COPY public ./public
RUN useradd --uid 10001 --no-create-home appuser
USER appuser
EXPOSE 80
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-80}"]
