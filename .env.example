# LOCAL: demo por defecto; no escribe ni en Oracle ni SQL Server.
APP_MODE=demo
OCR_LANG=eng
ENABLE_REAL_UPLOADS=true

# CORPORATE (solo en entorno privado y con acceso autenticado)
# APP_MODE=corporate
# APP_ACCESS_TOKEN=generar_token_largo_aleatorio
# SQLSERVER_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=servidor;DATABASE=DemoINE;UID=usuario;PWD=clave;Encrypt=yes;TrustServerCertificate=no;
# ORACLE_USER=usuario
# ORACLE_PASSWORD=clave
# ORACLE_DSN=hostname:1521/nombre_servicio

# Vercel: recomienda ENABLE_REAL_UPLOADS=false y APP_MODE=demo.
